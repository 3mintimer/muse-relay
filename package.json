{
  "name": "muse-relay",
  "private": true,
  "version": "0.3.20",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts tests/navigation.test.ts tests/images.test.ts tests/glass-text.test.ts && node --test tests/server.test.mjs adapters/gist/watcher.test.mjs server/cloudflare/worker.test.mjs",
    "relay:setup": "node server/setup.mjs",
    "relay:start": "node server/index.mjs",
    "pack": "node scripts/pack.mjs",
    "gist:watch": "node adapters/gist/watcher.mjs"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^26.6.6",
    "playwright-core": "1.65.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/pretext": "0.1.4"
  },
  "license": "MIT"
}
