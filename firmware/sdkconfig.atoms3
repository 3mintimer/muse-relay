# ATOM S3 (ESP32-S3, 8 MB flash, no PSRAM). The phone/G2 supplies all audio/UI.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_DEVICE_MODEL_ID="muse-gadget-m5stack-atoms3"
CONFIG_MUSE_DEVICE_MODEL_NAME="M5Stack ATOM S3 / Muse Relay"
CONFIG_MUSE_DEVICE_GUIDE="guide.md"
CONFIG_GADGET_PRODUCT_NAME="Muse Relay"
CONFIG_HOMEHUB_BUTTON_GPIO=41
CONFIG_HOMEHUB_BUTTON_LABEL="front button"
CONFIG_HOMEHUB_LED_BACKEND_NONE=y
CONFIG_MUSE_BOARD_NONE=y
CONFIG_MUSE_ENABLED=n
CONFIG_SPIRAM=n
CONFIG_HOMEHUB_TUNNEL=n
CONFIG_MUSE_RELAY_COMPACT_NOISE=y
CONFIG_HOMEHUB_DAEMON_REQUESTS=y
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_HOMEHUB_SUPPORT_BUG_REPORT=n
CONFIG_HOMEHUB_BLE_COMMANDS=n
CONFIG_HOMEHUB_BLE_PERSISTENT=n
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
