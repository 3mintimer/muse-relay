# Set these in your hosting platform's secret/environment settings.
# Generate three different 32+ character random tokens with the local setup UI.
RELAY_TOKEN=
DEVICE_TOKEN=
MUSE_TOKEN=
SONIOX_API_KEY=
PUBLIC_URL=https://relay.example.com
# Even's loopback origin can change port at launch. This exact opt-in rule allows it.
# Add other exact origins, comma-separated; add "null" only if your WebView sends it.
ALLOWED_ORIGINS=http://127.0.0.1:*
HOST=127.0.0.1
PORT=8787
# Experimental: Muse Gadget image-file intake must be verified before enabling.
GADGET_IMAGES_ENABLED=false
