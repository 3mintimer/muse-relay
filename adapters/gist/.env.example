# Fill privately or supply through your runtime's secret manager.
GIST_ID=
GITHUB_TOKEN=
# User/Muse-provided executable, not a shell command. The watcher does not implement an AI agent.
MUSE_HANDLER=/absolute/path/to/handler
MUSE_HANDLER_ARGS=[]
GIST_POLL_SECONDS=15
GIST_STATE_FILE=.local/gist-watcher/state.json
